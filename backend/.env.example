# Application
APP_ENV=development
APP_NAME=Resolvent Billing Software API

# Use one complete SQLAlchemy connection URL.
# Local PostgreSQL example:
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/resolvent_billing_dev

# Comma-separated frontend origins. Do not use * with credentials in staging/production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication/security
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
